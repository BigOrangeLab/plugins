<?xml version="1.0"?>
<ruleset name="bol-plugins">
    <description>WordPress Coding Standards for the Big Orange Lab plugin portfolio.</description>

    <!-- Scan every plugin. Each plugin also ships its own phpcs.xml for targeted,
         per-plugin tuning (minimum_supported_wp_version, testVersion). -->
    <file>./bol-split-testing</file>
    <file>./bol-easy-translations</file>
    <file>./big-orange-pardot</file>

    <!-- Exclude build artifacts, deps, and VCS internals -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>

    <!-- Ruleset -->
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <!-- Minimum WP version for deprecated-function checks -->
    <config name="minimum_supported_wp_version" value="6.0"/>

    <!-- PHP compatibility range (advisory; install phpcompatibility-wp to enforce) -->
    <config name="testVersion" value="7.4-"/>

    <!-- Show sniff codes in reports for easier suppression -->
    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
</ruleset>
